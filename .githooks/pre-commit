#!/bin/sh
# Block accidental commit of API keys, local settings, logs, and analysis records.
set -e

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

for path in $staged; do
	case "$path" in
		config/settings.json|config/settings.local.json|config/exception_state.json|config/secret.key)
			echo "pre-commit: blocked sensitive file: $path"
			exit 1
			;;
		.env|.env.*)
			echo "pre-commit: blocked env file: $path"
			exit 1
			;;
		logs/*)
			echo "pre-commit: blocked log file: $path"
			exit 1
			;;
		records/pending/*.json|records/pending/*.jsonl)
			echo "pre-commit: blocked analysis record: $path"
			exit 1
			;;
	esac
done

if git diff --cached -U0 | grep '^+' | grep -v '^+++' | grep -E \
	'api_key_encrypted["[:space:]]*:[[:space:]]*"[A-Za-z0-9+/=]{20,}"|"api_key"[[:space:]]*:[[:space:]]*"[^*]{8,}"|sk-[A-Za-z0-9]{12,}' \
	>/dev/null 2>&1; then
	echo "pre-commit: staged diff may contain API key material (api_key / api_key_encrypted / sk-...)"
	echo "Unstage those changes; keep secrets in config/settings.json (gitignored) only."
	exit 1
fi

# ── 多会话写入范围检查（见 SESSION_CHANGES.md / AGENTS.md「多会话协作规范」）──
# 暂存文件落在他人声明的「进行中」范围内 → 阻断。
# 确认无冲突要绕过：SKIP_WRITE_SCOPE_CHECK=1 git commit ...
if [ "${SKIP_WRITE_SCOPE_CHECK:-}" = "1" ]; then
	echo "pre-commit: skipped write-scope check (SKIP_WRITE_SCOPE_CHECK=1)"
else
	repo_root=$(git rev-parse --show-toplevel)
	py=""
	for cand in python3 python; do
		if command -v "$cand" >/dev/null 2>&1; then py="$cand"; break; fi
	done
	if [ -n "$py" ]; then
		"$py" "$repo_root/tools/check_write_scope.py" --hook || exit 1
	else
		echo "pre-commit: warn — python not found, skipped write-scope check"
	fi
fi

exit 0
