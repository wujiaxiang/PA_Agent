# =============================================================================
# PA Agent — 仅上传源代码与项目文档；本地运行数据、密钥、临时文件不入库
# =============================================================================

# ── Python / 构建产物 ─────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/

# ── 密钥与本地配置（切勿提交）────────────────────────────────────────────────
.env
.env.*
config/settings.json
config/settings.local.json
config/exception_state.json
config/secret.key
# HMAC 令牌签名密钥（storage/auth.py 开发态自动生成，0600）。
# 提交它等于把签发权交给所有拿到仓库的人，且 git 历史会永久保留。
config/token_secret
# settings.json 的灾备副本：与 settings.json 同样含凭证面，且文件名不匹配
# 上面的规则，通配符删除事故里已吃过一次亏。
config/settings.json.*
config/tv_symbol_aliases.json
config/feishu.json
*.pem
*.key

# ── 运行时数据（分析记录、经验库、日志、交易导出）────────────────────────────
logs/*
!logs/.gitkeep

records/**/*
!records/**/.gitkeep

experience/**/*
!experience/**/.gitkeep

trade_records/*
!trade_records/.gitkeep

